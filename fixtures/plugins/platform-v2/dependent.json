{
  "schema": "aibo.plugin-manifest/v2",
  "pluginId": "dev.aibo.capability-parent",
  "version": "1.0.0",
  "displayName": "Capability Parent",
  "host": {
    "min": "0.1.0",
    "maxExclusive": "0.2.0"
  },
  "platforms": [
    "darwin-arm64",
    "darwin-x64",
    "windows-x64",
    "linux-x64",
    "linux-arm64"
  ],
  "protocols": {
    "runtime": {
      "min": "2.0",
      "max": "2.0"
    }
  },
  "contributions": [
    {
      "kind": "capabilityProvider",
      "id": "dev.aibo.capability-parent.read",
      "scope": "workspace",
      "required": true,
      "displayName": "Read fixture",
      "operations": [
        {
          "id": "dev.aibo.capability-parent.echo",
          "capability": {
            "id": "dev.aibo.capability-parent.echo",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string",
                "maxLength": 1024
              },
              "delayMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "mode": {
                "enum": [
                  "normal",
                  "wrong-generation",
                  "wrong-output",
                  "crash"
                ]
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "workspacePath"
            ],
            "properties": {
              "value": {
                "type": "string",
                "maxLength": 1024
              },
              "workspacePath": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 4096
              }
            }
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 1000,
          "idempotent": true
        }
      ]
    },
    {
      "kind": "capabilityProvider",
      "id": "dev.aibo.capability-parent.optional",
      "scope": "workspace",
      "required": true,
      "displayName": "Read fixture",
      "operations": [
        {
          "id": "dev.aibo.capability-parent.optional-echo",
          "capability": {
            "id": "dev.aibo.capability-parent.optional-echo",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string",
                "maxLength": 1024
              },
              "delayMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "mode": {
                "enum": [
                  "normal",
                  "wrong-generation",
                  "wrong-output",
                  "crash"
                ]
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "workspacePath"
            ],
            "properties": {
              "value": {
                "type": "string",
                "maxLength": 1024
              },
              "workspacePath": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 4096
              }
            }
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 1000,
          "idempotent": true
        }
      ]
    }
  ],
  "entrypoint": {
    "executable": "worker.mjs"
  },
  "executableDependencies": [
    {
      "kind": "runtime",
      "name": "node",
      "versionRange": ">=22",
      "required": true
    }
  ],
  "packageDependencies": [
    {
      "pluginId": "dev.aibo.capability-echo",
      "version": {
        "min": "1.0.0",
        "maxExclusive": "2.0.0"
      },
      "required": false,
      "contributionIds": [
        "dev.aibo.capability-parent.optional"
      ]
    }
  ]
}
