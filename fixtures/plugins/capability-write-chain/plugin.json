{
  "schema": "aibo.plugin-manifest/v2",
  "pluginId": "dev.aibo.write-parent",
  "version": "1.0.0",
  "displayName": "Capability write chain fixture",
  "host": {
    "min": "0.1.0",
    "maxExclusive": "0.2.0"
  },
  "platforms": [
    "darwin-arm64",
    "darwin-x64",
    "linux-x64",
    "linux-arm64"
  ],
  "protocols": {
    "runtime": {
      "min": "2.0",
      "max": "2.0"
    }
  },
  "contributions": [
    {
      "kind": "capabilityProvider",
      "id": "dev.aibo.write-parent.worker",
      "scope": "workspace",
      "required": true,
      "displayName": "Call a dependent writer",
      "operations": [
        {
          "id": "dev.aibo.write-parent.run",
          "capability": {
            "id": "dev.aibo.write-parent.run",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string",
                "maxLength": 128
              },
              "mode": {
                "enum": [
                  "normal",
                  "slow",
                  "crash",
                  "invalid-output",
                  "parent-crash",
                  "duplicate",
                  "forged",
                  "undeclared",
                  "ignore-unknown"
                ]
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trace",
              "caller",
              "permissions",
              "chain",
              "deadline"
            ],
            "properties": {
              "trace": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 32
              },
              "caller": {
                "type": "string"
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "chain": {
                "type": "string",
                "maxLength": 8192
              },
              "deadline": {
                "type": "integer"
              }
            }
          },
          "effect": "write",
          "permissions": [
            "workspace.read",
            "workspace.write"
          ],
          "timeoutMs": 30000,
          "idempotent": false
        }
      ]
    }
  ],
  "entrypoint": {
    "executable": "worker.mjs"
  },
  "executableDependencies": [
    {
      "kind": "runtime",
      "name": "node",
      "versionRange": ">=22",
      "required": true
    }
  ],
  "packageDependencies": [
    {
      "pluginId": "dev.aibo.write-leaf",
      "version": {
        "min": "1.0.0",
        "maxExclusive": "2.0.0"
      },
      "required": true,
      "contributionIds": [
        "dev.aibo.write-parent.worker"
      ]
    }
  ]
}
