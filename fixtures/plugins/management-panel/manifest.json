      ]
    },
    {
      "kind": "managementPanel",
      "id": "dev.example.management.management",
      "scope": "application",
      "required": false,
      "title": "Example Agent",
      "contractVersion": "1.0.0",
      "relatedContributions": [
        "dev.example.management.agent",
        "dev.example.management.secondary.agent"
      ],
      "sections": [
        {
          "id": "behavior",
          "title": "Behavior",
          "scopes": [
            "application",
            "workspace",
            "session"
          ],
          "settingsReferences": [
            {
              "key": "instructions",
              "contributionId": "dev.example.management.agent",
              "scopes": [
                "application",
                "workspace",
                "session"
              ]
            },
            {
              "key": "second",
              "contributionId": "dev.example.management.secondary.agent",
              "scopes": [
