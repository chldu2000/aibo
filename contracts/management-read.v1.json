{
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sectionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "required": [
      "sectionId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema": {
        "const": "aibo.management-data/v1"
      },
      "target": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "label": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": [
          "id",
          "label"
        ]
      },
      "state": {
        "enum": [
          "ready",
          "unavailable"
        ]
      },
      "message": {
        "type": "string",
        "maxLength": 1024
      },
      "observedAt": {
        "type": "string",
        "maxLength": 64
      },
      "properties": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "label": {
              "type": "string",
              "maxLength": 128
            },
            "value": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "key",
            "label",
            "value"
          ]
        }
      },
      "metrics": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "label": {
              "type": "string",
              "maxLength": 128
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "maxLength": 32
            },
            "maximum": {
              "type": "number",
              "minimum": 1e-06
            },
            "resetsAt": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "key",
            "label",
            "value",
            "unit"
          ]
        }
      }
    },
    "required": [
      "schema",
      "target",
      "state",
      "message",
      "observedAt",
      "properties",
      "metrics"
    ]
  }
}
