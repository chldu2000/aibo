{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibo.local/contracts/execution-profile.v1.schema.json",
  "title": "Aibo execution profile v1",
  "type": "object",
  "required": [
    "schema",
    "interactionMode",
    "approvalPolicy",
    "approvalReviewer",
    "filesystemPolicy",
    "commandPolicy",
    "networkPolicy"
  ],
  "properties": {
    "schema": {
      "const": "aibo.execution-profile/v1"
    },
    "interactionMode": {
      "enum": [
        "ask",
        "plan",
        "edit"
      ]
    },
    "approvalPolicy": {
      "enum": [
        "never",
        "untrusted",
        "on-request",
        "trusted"
      ]
    },
    "approvalReviewer": {
      "enum": [
        "user",
        "auto-review",
        "none"
      ]
    },
    "filesystemPolicy": {
      "enum": [
        "read-only",
        "workspace-write",
        "danger-full-access"
      ]
    },
    "commandPolicy": {
      "enum": [
        "disabled",
        "approved",
        "trusted"
      ]
    },
    "networkPolicy": {
      "enum": [
        "disabled",
        "agent-managed"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasoningEffort": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resolved": {
      "type": "object",
      "required": [
        "schema",
        "requested",
        "enforced",
        "unsupported",
        "adapterCapabilities",
        "nativeSandbox",
        "resolvedAt"
      ],
      "properties": {
        "schema": {
          "const": "aibo.execution-profile/v1"
        },
        "requested": {
          "$ref": "#"
        },
        "enforced": {
          "$ref": "#"
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adapterCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nativeSandbox": {
          "type": "boolean"
        },
        "resolvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sessionControls": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "label",
              "description",
              "profile"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]*$",
                "maxLength": 80
              },
              "kind": {
                "enum": [
                  "permission",
                  "mode"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "maxLength": 300
              },
              "command": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "maxLength": 40
              },
              "profile": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "interactionMode": {
                    "enum": [
                      "ask",
                      "plan",
                      "edit"
                    ]
                  },
                  "approvalPolicy": {
                    "enum": [
                      "never",
                      "untrusted",
                      "on-request",
                      "trusted"
                    ]
                  },
                  "approvalReviewer": {
                    "enum": [
                      "user",
                      "auto-review",
                      "none"
                    ]
                  },
                  "filesystemPolicy": {
                    "enum": [
                      "read-only",
                      "workspace-write",
                      "danger-full-access"
                    ]
                  },
                  "commandPolicy": {
                    "enum": [
                      "disabled",
                      "approved",
                      "trusted"
                    ]
                  },
                  "networkPolicy": {
                    "enum": [
                      "disabled",
                      "agent-managed"
                    ]
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "permission"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "profile": {
                      "not": {
                        "required": [
                          "interactionMode"
                        ]
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "mode"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "profile": {
                      "required": [
                        "interactionMode"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
