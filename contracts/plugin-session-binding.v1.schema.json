{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibo.local/contracts/plugin-session-binding.v1.schema.json",
  "title": "Aibo Plugin Session Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sessionId",
    "pluginInstallationId",
    "pluginId",
    "pluginVersion",
    "agentId",
    "nativeSessionId",
    "runtimeProtocolVersion",
    "recovery",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schema": { "const": "aibo.plugin-session-binding/v1" },
    "sessionId": { "type": "string", "minLength": 1 },
    "pluginInstallationId": { "type": "string", "minLength": 1 },
    "pluginId": { "$ref": "#/$defs/namespacedId" },
    "pluginVersion": { "$ref": "#/$defs/semver" },
    "agentId": { "$ref": "#/$defs/namespacedId" },
    "nativeSessionId": { "type": ["string", "null"] },
    "runtimeProtocolVersion": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" },
    "recovery": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "version", "data"],
          "properties": {
            "schema": { "$ref": "#/$defs/namespacedId" },
            "version": { "type": "integer", "minimum": 1 },
            "data": { "type": "object" }
          }
        }
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "namespacedId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    }
  }
}
