{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nativeSessionId",
    "turnId",
    "type",
    "correlation",
    "payload"
  ],
  "properties": {
    "nativeSessionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "turnId": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "enum": [
        "session.started",
        "session.state_changed",
        "turn.started",
        "turn.completed",
        "turn.failed",
        "message.delta",
        "message.completed",
        "reasoning.updated",
        "reasoning.completed",
        "tool.started",
        "tool.updated",
        "tool.completed",
        "approval.requested",
        "approval.resolved",
        "user_input.requested",
        "user_input.resolved",
        "usage.updated",
        "queue.updated",
        "compaction.started",
        "compaction.completed",
        "retry.started",
        "retry.completed",
        "extension.updated",
        "session.info_changed",
        "adapter.warning",
        "adapter.crashed",
        "workspace.requested",
        "goal.updated",
        "subagent.updated",
        "subagent.message"
      ]
    },
    "correlation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requestId": {
              "type": [
                "string",
                "integer",
                "null"
              ]
            },
            "itemId": {
              "type": [
                "string",
                "null"
              ]
            },
            "toolCallId": {
              "type": [
                "string",
                "null"
              ]
            },
            "approvalId": {
              "type": [
                "string",
                "integer",
                "null"
              ]
            }
          }
        }
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibo.local/contracts/session-event.v1.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "subagent.updated"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "turnId": {
            "type": "null"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "parentId",
              "rootTurnId",
              "name",
              "task",
              "status",
              "activity"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "parentId": {
                "type": "string",
                "minLength": 1
              },
              "rootTurnId": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              },
              "task": {
                "type": "string"
              },
              "activity": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "pending",
                  "running",
                  "waiting",
                  "completed",
                  "failed",
                  "interrupted",
                  "closed",
                  "unavailable"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "subagent.message"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "turnId": {
            "type": "null"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agentId",
              "rootTurnId",
              "entry"
            ],
            "properties": {
              "agentId": {
                "type": "string",
                "minLength": 1
              },
              "rootTurnId": {
                "type": "string",
                "minLength": 1
              },
              "entry": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "role",
                  "toolName",
                  "content",
                  "status"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "enum": [
                      "user",
                      "assistant",
                      "system",
                      "tool"
                    ]
                  },
                  "toolName": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "content": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "streaming",
                      "completed",
                      "failed",
                      "interrupted"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
