{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aibo.local/contracts/agent-settings.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "title",
    "scopes",
    "fields"
  ],
  "properties": {
    "schema": {
      "const": "aibo.agent-settings/v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "application",
          "workspace",
          "session"
        ]
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "type",
          "default"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "type": {
            "enum": [
              "text",
              "multiline",
              "boolean",
              "number",
              "select"
            ]
          },
          "default": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "label"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "maxLength": 256
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              }
            }
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "maxLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          }
        }
      }
    }
  }
}
