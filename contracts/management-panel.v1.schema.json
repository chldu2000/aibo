{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aibo.dev/contracts/management-panel.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "managementPanel"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scope": {
      "const": "application"
    },
    "required": {
      "const": false
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "relatedContributions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9.-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "application",
                "workspace",
                "session"
              ]
            }
          },
          "settingsReferences": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9.-]{0,63}$"
                },
                "contributionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "scopes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "application",
                      "workspace",
                      "session"
                    ]
                  }
                }
              },
              "required": [
                "key",
                "contributionId",
                "scopes"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "scopes",
          "settingsReferences"
        ]
      }
    }
  },
  "required": [
    "kind",
    "id",
    "scope",
    "required",
    "title",
    "contractVersion",
    "relatedContributions",
    "sections"
  ]
}
