    "probe:pi:plugin:smoke": "node probes/pi-plugin-smoke.mjs",
    "probe:pi:plugin:diff": "node probes/pi-plugin-diff.mjs",
    "probe": "node probes/run-all.mjs",
    "check:architecture": "node --test test/architecture-boundaries.test.mjs test/ui-style-boundaries.test.mjs test/presentation-boundaries.test.mjs",
