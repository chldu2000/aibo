    "probe:codex": "node probes/codex-app-server.mjs",
    "probe:codex:smoke": "node probes/codex-app-server.mjs --smoke",
    "probe:codex:approval": "node probes/codex-app-server.mjs --approval",
    "probe:codex:lifecycle": "node probes/codex-app-server.mjs --lifecycle",
    "probe:pi": "node probes/run-pi.mjs",
