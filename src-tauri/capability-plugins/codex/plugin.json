            "properties": {
              "action": {
                "enum": [
                  "list",
                  "set"
                ]
              },
              "level": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "recovery",
              "capabilities"
            ]
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 120000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.codex.operation.skills",
          "capability": {
            "id": "dev.aibo.codex.skill.list",
            "version": "1.0.0"
