            "properties": {
              "action": {
                "enum": [
                  "list",
                  "set"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "recovery",
              "capabilities"
            ]
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 120000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.codex.operation.reasoning",
          "capability": {
            "id": "dev.aibo.codex.model.reasoning",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
