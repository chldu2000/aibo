            "id": "aibo.session.open",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "executionProfile"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "create",
                  "resume"
                ]
              },
              "executionProfile": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "interactionMode": {
                    "enum": [
                      "ask",
                      "plan",
                      "edit"
                    ]
                  },
                  "approvalPolicy": {
                    "type": "string"
                  },
                  "approvalReviewer": {
                    "enum": [
                      "user",
                      "auto-review",
                      "none"
                    ]
                  },
                  "filesystemPolicy": {
                    "type": "string"
                  },
                  "commandPolicy": {
                    "type": "string"
                  },
                  "networkPolicy": {
                    "type": "string"
                  },
                  "model": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reasoningEffort": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "schema": {
                    "type": "string"
                  }
                }
              },
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
