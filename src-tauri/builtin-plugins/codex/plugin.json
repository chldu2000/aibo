{
  "schema": "aibo.plugin-manifest/v1",
  "pluginId": "dev.aibo.codex",
  "version": "1.0.0",
  "displayName": "Codex (built-in plugin)",
  "description": "Aibo's bundled Codex app-server adapter.",
  "publisher": { "name": "Aibo" },
  "protocols": { "runtime": { "min": "1.0", "max": "1.0" }, "view": { "min": "1.0", "max": "1.0" } },
  "platforms": ["darwin-arm64", "darwin-x64", "windows-x64", "linux-x64", "linux-arm64"],
  "entrypoint": { "executable": "codex-plugin.mjs" },
  "dependencies": [
    { "kind": "runtime", "name": "node", "versionRange": ">=22", "required": true },
    { "kind": "executable", "name": "codex", "required": true }
  ],
  "resources": [],
  "agents": [{
    "agentId": "dev.aibo.codex.agent",
    "displayName": "Codex",
    "description": "Codex app-server through the Aibo Agent Runtime Protocol.",
    "capabilities": ["session.create", "session.resume", "session.close", "turn.send", "turn.cancel", "stream.text", "view.standard", "goal.manage", "model.select", "model.reasoning", "skill.list", "approval.respond", "user-input.respond"],
    "requestedPermissions": [{ "id": "workspace.read", "required": true, "reason": "Starts Codex in the selected trusted workspace." }],
    "operations": [{
      "id": "ext.dev.aibo.codex.goal",
      "capability": "goal.manage",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {
          "action": { "enum": ["get", "set", "clear"] },
          "objective": { "type": "string", "minLength": 1 },
          "tokenBudget": { "type": "integer", "minimum": 1 }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["goal"],
        "properties": { "goal": { "type": ["object", "null"] } }
      }
    }, {
      "id": "ext.dev.aibo.codex.model",
      "capability": "model.select",
      "inputSchema": { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "enum": ["list", "set"] }, "reference": { "type": "string", "minLength": 1 } } },
      "outputSchema": { "type": "object" }
    }, {
      "id": "ext.dev.aibo.codex.reasoning",
      "capability": "model.reasoning",
      "inputSchema": { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "enum": ["list", "set"] }, "level": { "type": "string", "minLength": 1 } } },
      "outputSchema": { "type": "object" }
    }, {
      "id": "ext.dev.aibo.codex.skills",
      "capability": "skill.list",
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": { "type": "object", "required": ["skills"], "properties": { "skills": { "type": "array" } } }
    }, {
      "id": "ext.dev.aibo.codex.approval",
      "capability": "approval.respond",
      "inputSchema": { "type": "object", "additionalProperties": false, "required": ["requestId", "decision"], "properties": { "requestId": { "type": "string", "minLength": 1 }, "decision": { "enum": ["accept", "cancel"] } } },
      "outputSchema": { "type": "object", "additionalProperties": false, "required": ["resolved"], "properties": { "resolved": { "const": true } } }
    }, {
      "id": "ext.dev.aibo.codex.user-input",
      "capability": "user-input.respond",
      "inputSchema": { "type": "object", "additionalProperties": false, "required": ["requestId", "answers"], "properties": { "requestId": { "type": "string", "minLength": 1 }, "answers": { "type": "object" } } },
      "outputSchema": { "type": "object", "additionalProperties": false, "required": ["resolved"], "properties": { "resolved": { "const": true } } }
    }],
    "views": [{ "viewId": "dev.aibo.codex.status", "title": "Codex status", "requiredComponents": ["panel", "badge", "text"] }]
  }]
}
